# "sqlite" (local file at data/portfolio.db) or "mongodb". If unset: mongodb when MONGODB_URI
# is filled in, otherwise sqlite. Use mongodb on Vercel — SQLite writes don't persist there.
DB_PROVIDER=sqlite
# Optional custom location for the SQLite file
# SQLITE_PATH=./data/portfolio.db

# MongoDB Atlas connection string (replace <db_password> with your real password)
MONGODB_URI=mongodb+srv://gauravapihandler1_db_user:<db_password>@cluster0.ayl97rd.mongodb.net/portfolio?appName=Cluster0

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin login (single admin user)
ADMIN_EMAIL=you@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# IMPORTANT: Next.js expands $VAR inside .env files, which corrupts bcrypt hashes (they're full
# of $). Escape every $ as \$ when you paste the generated hash in, e.g. \$2a\$10\$abc...
ADMIN_PASSWORD_HASH=

# Cloudinary (server-side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary (client-side unsigned upload widget)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
